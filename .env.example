# =============================================================================
# ClipForge — viral-clip generator configuration
# Copy this file to `.env` and fill in the values you need.
# =============================================================================

# ---- LLM provider for viral-moment scoring ---------------------------------
# Set to "gemini" (free tier) or "openai" (paid).
LLM_PROVIDER=gemini

# Google Gemini (recommended — has a generous free tier)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional — only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Disable the LLM call entirely and fall back to the audio/keyword scoring
# engine only (free, but lower quality). Set to "true" to enable.
LLM_OFFLINE_ONLY=false

# ---- Whisper transcription --------------------------------------------------
# tiny / base / small / medium / large-v3
# base is a good balance. Use "tiny" for very fast CPU transcription.
WHISPER_MODEL_SIZE=base
# "auto" lets Whisper detect the language, or force a code like "en", "es", "fr"
WHISPER_LANGUAGE=auto

# ---- Video pipeline ---------------------------------------------------------
# Maximum number of viral-moment candidates to keep per video.
MAX_CANDIDATES=10
# Default minimum score (0-100) a candidate must have to appear in the UI.
MIN_SCORE=40
# Number of clips to actually render when the user hits "render all".
CLIPS_TO_RENDER=3
# Default aspect ratio for new jobs: 9:16 (Shorts/TikTok/Reels) | 1:1 | 16:9
DEFAULT_ASPECT_RATIO=9:16
# Download resolution: 360 / 480 / 720 / 1080
DEFAULT_RESOLUTION=720
# How many minutes of audio the LLM is asked to score per chunk.
# Lower for slower models, higher for cheaper / faster ones.
LLM_CHUNK_MINUTES=20

# ---- Server -----------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# Secret used to sign session cookies / protect API endpoints in production.
APP_SECRET=change-me-in-production
